# Cloudflare Pages headers. Cross-origin isolation enables multi-threaded WASM inference
# (faster CPU fallback on machines without WebGPU). All app assets are same-origin.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
