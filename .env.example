# Copy to .env and fill in. `.env` is git-ignored. The deploy script reads ONLY these values —
# it never uses a wrangler login session.

# Cloudflare API token (My Profile → API Tokens → Create Custom Token) with:
#   Account → Cloudflare Pages: Edit
#   Zone    → DNS: Edit          (zone: azprojects.net)
#   Zone    → Zone: Read         (zone: azprojects.net)
CLOUDFLARE_API_TOKEN=

# Account ID (dashboard → any zone → Overview → right column "API" → Account ID)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Pages project name (created automatically if missing)
CLOUDFLARE_PAGES_PROJECT=mediabox

# Zone that owns the custom domain, and the host name to serve the app from
CLOUDFLARE_ZONE=azprojects.net
DEPLOY_DOMAIN=mediabox.azprojects.net
